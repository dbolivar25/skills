#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"
source_root="$(git rev-parse --show-toplevel)"
amp_url="$(git -C "$source_root" remote get-url amp 2>/dev/null || true)"

if [[ "$remote_name" == "amp" || ( -n "$amp_url" && "$remote_url" == "$amp_url" ) ]]; then
  echo "Direct pushes to Amp are blocked because they bypass the WOFF2 filter." >&2
  echo "Push main to origin, or run: git publish-amp" >&2
  exit 1
fi

if [[ "$remote_name" != "origin" ]]; then
  exit 0
fi

zero_revision="0000000000000000000000000000000000000000"
main_revision=""

while read -r local_ref local_revision remote_ref remote_revision; do
  if [[ "$remote_ref" == "refs/heads/main" && "$local_revision" != "$zero_revision" ]]; then
    main_revision="$local_revision"
  fi
done

if [[ -z "$main_revision" ]]; then
  exit 0
fi

# Git has no client-side post-push hook, so Amp must publish first. The two pushes are not atomic.
echo "Publishing the filtered ${main_revision:0:12} snapshot to Amp before GitHub..."
"$source_root/scripts/publish-amp" "$main_revision"
